% ==========================================
%  style.sty — 技术报告样式文件
%  功能：定义文档整体视觉风格，包括标题页、目录、
%        章节标题、图表标题、参考文献、代码块等样式
%  编译：需 XeLaTeX / LuaLaTeX
% ==========================================
\ProvidesPackage{style}[Tech Report Style]

% ==========================================
% 一、基础宏包加载
% ==========================================
\RequirePackage{geometry}     % 页面边距设置
\RequirePackage{setspace}     % 行间距控制
\RequirePackage{parskip}      % 段落间距控制
\RequirePackage{xcolor}       % 颜色支持（文字、背景色等）
\RequirePackage{fontspec}
\RequirePackage{xeCJK}        % 中日韩文字支持（需 XeLaTeX）
\RequirePackage{graphicx}     % 图片插入（Logo 等）
\RequirePackage{booktabs}     % 三线表（\toprule, \midrule, \bottomrule）
\RequirePackage{amsmath}      % 数学公式支持
\RequirePackage{unicode-math} % Unicode 数学字体支持（需 XeLaTeX）
% 数学环境里的字母格式（\mathrm、\mathbf、\mathit、\mathsf、\mathtt 等）
% 默认都会跟随正文字体，这里统一改为使用数学字体本身，避免与正文混排。
% 如需恢复某一项跟随正文，把对应的 sym 改为 text 即可。
\unimathsetup{
    mathup=sym,
    mathrm=sym,
    mathit=sym,
    mathbf=sym,
    mathsf=sym,
    mathtt=sym,
}
\RequirePackage{titlesec}     % 章节标题格式定制
\RequirePackage{caption}      % 图表标题（Caption）格式定制
\RequirePackage{tocloft}      % 目录（Table of Contents）格式定制
\RequirePackage{enumitem}     % 列表环境（itemize/enumerate）定制
\RequirePackage{listings}     % 代码块高亮与格式
\RequirePackage{hyperref}     % 超链接与 PDF 书签
\RequirePackage{appendix}     % 附录支持
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{listings}      % 供代码块（codeblock）环境使用

% ==========================================
% 一-B、提示框与代码块（simplenote / lightnote / darknote / codeblock）
%    所有配色集中在此定义，环境样式见下方各定义
%    如需调整外观，直接修改对应颜色或选项即可
% ==========================================

% --- 提示框配色 ---
\definecolor{simpleshade}{HTML}{FFFFFF}
\definecolor{simplebar}{HTML}{FFFFFF}
\definecolor{simpletext}{HTML}{000000}   % simplenote 内文字颜色

\definecolor{lightshade}{HTML}{F7F7F7}
\definecolor{lightbar}{HTML}{113BC1}
\definecolor{lighttext}{HTML}{000000}    % lightnote 内文字颜色

% \definecolor{darkshade}{HTML}{212121}
% \definecolor{darkbar}{HTML}{F58967}
% \definecolor{darktext}{HTML}{FFFFFF}     % darknote 内文字颜色

\definecolor{codeshade}{HTML}{212121}    % 代码块背景色
\definecolor{codebar}{HTML}{212121}      % 代码块边框颜色
\definecolor{codetext}{HTML}{FFFFFF}     % 代码文字颜色
\definecolor{commentcolor}{HTML}{1FA954}
\definecolor{keywordcolor}{HTML}{F58967}
\definecolor{stringcolor}{HTML}{315DEC}

\definecolor{abstractfill}{HTML}{F7F7F7}   % 首页摘要框背景（风格 current）
\definecolor{abstractframe}{HTML}{113BC1}  % 首页摘要框边框（风格 en）

% --- 提示框环境（基于 tcolorbox）---
\newtcolorbox{simplenote}{
    enhanced,
    breakable,
    colback=simpleshade,        % 背景色
    colframe=simplebar,         % 色条颜色
    coltext=simpletext,         % 文字颜色
    boxrule=0pt,                % 默认无边框
    leftrule=0pt,
    toprule=0pt,
    rightrule=0pt,
    bottomrule=0pt,
    arc=0pt,                    % 直角
    left=24pt,                  
    right=25pt,
    top=24pt,
    bottom=24pt,
    parskip=0pt,
}

\newtcolorbox{lightnote}{
    enhanced,
    breakable,
    colback=lightshade,         % 背景色
    colframe=lightbar,          % 左侧色条颜色
    coltext=lighttext,          % 文字颜色
    boxrule=0pt,
    leftrule=2pt,               % 仅左侧 2pt 色条
    toprule=0pt,
    rightrule=0pt,
    bottomrule=0pt,
    arc=0pt,
    left=12pt,
    right=12pt,
    top=12pt,
    bottom=12pt,
    parskip=0pt,
}

